# Choose your provider: OPENAI, ANTHROPIC, GEMINI, or LOCAL
# (Keys are stored in-app via shared_preferences — this file is reference only.)
ACTIVE_PROVIDER=GEMINI

# API Keys
OPENAI_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here

# Local Provider (LiteLLM proxy) — optional
LOCAL_HOST=http://127.0.0.1:4000
LOCAL_MODEL=ollama/llama3.1
LOCAL_API_KEY=
